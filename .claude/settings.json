{
  "permissions": {
    "allow": [
      "Bash(git -C /home/user/meal-value log *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/meal-value/.claude/hooks/check-manifest-duplicate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/meal-value/.claude/hooks/validate-swift-syntax.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/meal-value/.claude/hooks/enforce-hk-contract.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/meal-value/.claude/hooks/update-manifest.sh"
          }
        ]
      }
    ]
  }
}
